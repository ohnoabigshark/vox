# The Ant: Thanksgiving's Crow, marching its lane up and down: three
# segments in a row, head, a narrow middle and a big striped back end, six
# legs and two antennae.
size 7 6 11
voxel 0.09
colors
  P purple
  d purpleDark
  l purpleLight
  w white
  k ink
# Head, eyes and antennae.
box 2 2 0 4 4 2 P
box 2 4 0 2 4 0 w
box 4 4 0 4 4 0 w
box 2 5 1 2 5 1 d
box 4 5 1 4 5 1 d
box 1 5 0 1 5 0 d
box 5 5 0 5 5 0 d
# The narrow middle.
box 3 2 3 3 3 5 d
# The back end, striped.
box 2 1 6 4 4 10 P
box 3 4 7 3 4 9 l
# Legs, spaced out along the middle and the front of the back end.
box 1 1 3 1 1 3 k
box 0 0 3 0 0 3 k
box 5 1 3 5 1 3 k
box 6 0 3 6 0 3 k
box 1 1 5 1 1 5 k
box 0 0 5 0 0 5 k
box 5 1 5 5 1 5 k
box 6 0 5 6 0 5 k
box 1 1 7 1 1 7 k
box 0 0 7 0 0 7 k
box 5 1 7 5 1 7 k
box 6 0 7 6 0 7 k
